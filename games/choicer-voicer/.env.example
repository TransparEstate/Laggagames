# Server
PORT=3000
# MAX_PACK_UPLOAD_MB=1500
# PACKS_DIR=./data/packs

# Cloudflare R2 — einziger Pack-Speicher (Upload + Katalog für alle Nutzer)
# Dashboard: https://dash.cloudflare.com → R2 → Bucket (z.B. choicer-voicer-packs)
# API Token: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=choicer-voicer-packs
# Optional statt R2_ACCOUNT_ID:
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# Optional: öffentliche Basis-URL (Custom Domain oder r2.dev Public URL)
# Dann laden Browser Video/Audio direkt aus R2
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Lokale Kopie nach Upload behalten? Nur Debug — Default 0 (Staging wird gelöscht)
# R2_KEEP_LOCAL=0
