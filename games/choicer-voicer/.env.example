# Server
PORT=3000
# MAX_PACK_UPLOAD_MB=1500
# PACKS_DIR=./data/packs

# Object Storage (Cloudflare R2 ODER Railway Bucket) — Packs überleben Redeploys
#
# Variante A — Railway Bucket (empfohlen auf Railway):
# R2_ENDPOINT=${{choicer-packs.ENDPOINT}}
# R2_BUCKET=${{choicer-packs.BUCKET}}
# R2_ACCESS_KEY_ID=${{choicer-packs.ACCESS_KEY_ID}}
# R2_SECRET_ACCESS_KEY=${{choicer-packs.SECRET_ACCESS_KEY}}
# R2_REGION=${{choicer-packs.REGION}}
#
# Variante B — Cloudflare R2:
# Dashboard: https://dash.cloudflare.com → R2 → Create bucket
# API Token: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=laggagames-packs
# Optional statt R2_ACCOUNT_ID: R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# Optional: öffentliche Basis-URL (Custom Domain oder r2.dev Public URL)
# Dann laden Browser Video/Audio direkt aus R2 (spart App-Traffic)
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Nach Upload lokale Kopie behalten? 1=ja (schnell lokal), 0=nein (nur Object Storage)
R2_KEEP_LOCAL=1
